# Copie para .env e preencha. NUNCA versione o .env.

# Chave da API do Gemini (https://aistudio.google.com/apikey)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
LLM_TEMPERATURE=0.4
LLM_MAX_OUTPUT_TOKENS=1024

# Timeouts em segundos
LLM_FIRST_TOKEN_TIMEOUT=20
LLM_IDLE_TIMEOUT=15
LLM_TOTAL_TIMEOUT=90

# Limites de entrada
MAX_MESSAGE_CHARS=4000
MAX_TURNS=20
MAX_TOTAL_CHARS=24000
MAX_BODY_BYTES=200000

# Rate limit por IP (0 desativa)
RATE_LIMIT_REQUESTS=20
RATE_LIMIT_WINDOW_SECONDS=60

# Origens liberadas no CORS, separadas por vírgula
ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

LOG_LEVEL=INFO

# RAG (busca nos documentos de app/rag/docs)
RAG_ENABLED=true
RAG_TOP_K=3
RAG_TIMEOUT=5
EMBEDDING_MODEL=gemini-embedding-001
